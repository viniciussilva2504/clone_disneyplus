    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "gif-encoder-2": "^1.0.4",
    "pngjs": "^7.0.0",
    "puppeteer": "^22.0.0",
    "sass": "^1.99.0"
  }
