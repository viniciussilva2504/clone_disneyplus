{
  "name": "clone_disneyplus",
  "version": "1.0.0",
  "description": "Clone da landing page do Disney+ construido com HTML, SCSS e Gulp.",
  "author": "Vinicius Silva <viniciussilva2504@github.com>",
  "license": "MIT",
  "scripts": {
    "start": "npm run dev",
    "dev": "gulp watch",
    "build": "gulp",
    "screenshot": "node scripts/screenshot.js",
    "lint:js": "eslint src/scripts/**/*.js",
    "lint:css": "stylelint src/scss/**/*.scss",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "prettier --write .",
    "validate:html": "html-validate index.html"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "eslint": "^10.2.1",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-newer": "^1.4.0",
    "gulp-plumber": "^1.2.1",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^2.6.5",
    "gulp-terser": "^2.1.0",
    "html-validate": "^10.13.1",
    "prettier": "^3.8.3",
    "puppeteer": "^22.0.0",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "stylelint": "^17.9.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "through2": "^4.0.2"
  }
}
